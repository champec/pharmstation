# PharmStation NHS 111 Infrastructure — Environment Variables
# ===========================================================
# Copy this file to .env and fill in the values.
# DO NOT commit the .env file to version control.

# ─── RabbitMQ ───────────────────────────────────────────────────────
RABBITMQ_USERNAME=pharmstation
RABBITMQ_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── NHS 111 Adaptor — ODS/DoS Configuration ───────────────────────
# URL to your get-ods-dos-codes edge function. The adaptor fetches
# allowed ODS codes from this endpoint on startup and periodically.
ODS_DOS_CONFIG_URL=https://xsqwpmqfbirqdncoephf.supabase.co/functions/v1/get-ods-dos-codes

# Enable SOAP XML schema validation on incoming ITK messages
# Set to "true" for production, "false" for testing
SOAP_VALIDATION_ENABLED=false

# ─── AMQP Exchange (CRITICAL) ──────────────────────────────────────
# The NHS 111 adaptor uses the RabbitMQ JMS client which publishes to
# the "jms.durable.queues" exchange. This MUST be set — leaving it
# empty causes the JMS client to use an internal path that the bridge
# cannot consume from. DO NOT change this value.
PEM111_AMQP_EXCHANGE=jms.durable.queues

# ─── Bridge → Supabase ─────────────────────────────────────────────
# Full URL to the nhs111-receive edge function
SUPABASE_FUNCTION_URL=https://xsqwpmqfbirqdncoephf.supabase.co/functions/v1/nhs111-receive

# Supabase anon/public key (safe to use — RLS protects data)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ─── Logging ────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ─── TLS Mutual Authentication (Production Only) ───────────────────
# These are only needed when connecting to the live NHS 111 network.
# For testing/dev you can leave these blank.
# NGINX_PUBLIC_CERT=
# NGINX_PRIVATE_CERT=
# NGINX_CLIENT_PUBLIC_CERT=
# NGINX_CA_CERT=
