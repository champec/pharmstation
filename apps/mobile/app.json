{
  "expo": {
    "name": "PharmStation",
    "slug": "pharmstation-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pharmstation",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pharmstation.mobile"
    },
    "android": {
      "package": "com.pharmstation.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "PharmStation uses the camera to scan prescriptions, invoices, and medication barcodes (GTIN).",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PharmStation accesses your photos to attach prescription and invoice images to records."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PharmStation uses your location to track delivery progress and plot delivery routes.",
          "locationAlwaysAndWhenInUsePermission": "PharmStation uses your location to keep delivery tracking accurate while the app is in the background.",
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "PharmStation uses Face ID to secure access to the controlled drugs register and patient data."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/93bbae05-5861-493b-9810-168c9999d569"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93bbae05-5861-493b-9810-168c9999d569"
      }
    }
  }
}
