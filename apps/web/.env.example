# Web app build-time variables (set in Vercel → Settings → Environment Variables).
# VITE_ variables are bundled into the browser code, so never put secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_APP_URL=https://pharmstation.co.uk
# Cloudflare Turnstile site key (public; the app falls back to this same key
# when unset). Its secret key belongs only in
# Supabase Edge Function secrets as TURNSTILE_SECRET_KEY. Vercel must
# rebuild after this changes.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAF1C-lRDsx8b3Ye5
# NHS services (library, delivery) stay "Coming soon" until NHS approval.
# Leave unset or false; set to true only once NHS services are approved.
VITE_NHS_SERVICES_ENABLED=
# Google Ads conversion tracking (public IDs, not secrets). Leave unset to
# keep the site tag-free. When set, patient pages show a consent banner and
# the tag only stores cookies after the visitor accepts.
# VITE_GOOGLE_ADS_ID=AW-123456789
# VITE_GOOGLE_ADS_BOOKING_LABEL=AbCdEfGhIjk
# VITE_GOOGLE_ADS_PURCHASE_LABEL=LmNoPqRsTuv
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_BOOKING_LABEL=
VITE_GOOGLE_ADS_PURCHASE_LABEL=
