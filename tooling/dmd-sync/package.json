{
  "name": "@pharmstation/dmd-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated NHS dm+d (dictionary of medicines and devices) sync pipeline: download from TRUD, parse XML, load into Supabase.",
  "main": "./src/index.ts",
  "bin": {
    "dmd-sync": "./src/cli.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts sync",
    "sync": "tsx src/cli.ts sync",
    "reconcile": "tsx src/cli.ts reconcile",
    "status": "tsx src/cli.ts status",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.7",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
